# /etc/flame/sandboxd.env - environment for flame-sandboxd.service only. Mode 0600.
#
# The unit loads this file after /etc/flame/flame.env, so anything here wins. It exists for the one setting
# that has no configuration field: the Consul ACL token.
#
# Neither RegistryConfig (sandboxd, browserd) nor DiscoveryConfig (sandboxg, browserg) has a token field, and
# the Consul client only reads CONSUL_HTTP_TOKEN. With ACLs enabled, both ends need it: the executors that
# register, and the gateways that discover.
#
# CONSUL_HTTP_TOKEN=<token>
#
# browserd reads the same variable from its own unit; add an identical file (/etc/flame/browserd.env) and an
# EnvironmentFile line in flame-browserd.service if ACLs are in use.
