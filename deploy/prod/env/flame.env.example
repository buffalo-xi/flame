# NOT a file to copy: the <...> placeholders are not valid values (a space in a shell assignment). install.sh
# generates the real one with those commands already executed. This copy is read as documentation.
#
# /etc/flame/flame.env - the one file a deployment owns. Mode 0600, read by the `flame` wrapper before every
# compose command and mounted into the nexus and bootstrap containers (their configuration files carry ${VAR}
# placeholders that are expanded from this environment).
#
# install.sh writes this file on a fresh machine with random secrets in place of the <...> below, and never
# overwrites it afterwards. This copy is the documentation: what each variable is for, and what breaks when it
# changes. The impact/rotation table is env/SECRETS.md.

# ---- version -----------------------------------------------------------------
# The only version number: image tags and /opt/flame/releases/<ver> both use it. Upgrading and rolling back is
# changing this line plus `flame up -d`.
FLAME_TAG=v2026.12.01

# Where the four Flame images live. `flame` for a release built on this host (scripts/build.sh + images.sh build);
# a registry prefix (install.sh --registry ghcr.io/<org>/flame) for images pulled from one. compose.yaml and the
# rendered sandboxd.yaml both read it, so a wrong value reads as "image not found" at `flame up -d`, not here.
FLAME_IMAGE_NS=flame

# ---- tier --------------------------------------------------------------------
# 1: everything on this host (loopback publish of consul, so the bare executors can register).
# 2: this host runs the container stack, other hosts only run sandboxd / browserd -> set the intranet IP.
# 3: containers are split across machines -> also set COMPOSE_FILE.
FLAME_BIND_IP=127.0.0.1
COMPOSE_FILE=compose.yaml
# Tier 3: COMPOSE_FILE=compose.yaml:compose.multi-host.yaml

# Where 27001 and 27443 are published on this host. Full capability means a plaintext Bearer token on the
# wire: keep 27001 on the intranet, or on loopback when an upstream load balancer terminates TLS.
FLAME_PUBLISH_IP=0.0.0.0
FLAME_TLS_IP=0.0.0.0

# ---- secrets -----------------------------------------------------------------
# Hex, not base64: POSTGRES_PASSWORD ends up inside the LiteLLM DATABASE_URL, where +/= would need escaping.
POSTGRES_PASSWORD=<openssl rand -hex 24>
REDIS_PASSWORD=<openssl rand -hex 24>
# Signs every token. Rotating it logs everybody out (acceptable). Leaking it lets anyone mint a token for any
# tenant (not acceptable).
JWT_SECRET=<openssl rand -hex 24>
# Encrypts global_vars rows stored with kind=secret. Rotating it makes every stored ciphertext unreadable -
# there is no double-key transition in this release.
FLAME_VALUE_KEY=<openssl rand -hex 24>
# LiteLLM's control plane, shared by nexus and the gateway container.
LITELLM_MASTER_KEY=sk-<openssl rand -hex 24>
# Decrypts the provider keys stored in LiteLLM's own database. Never rotate it.
LITELLM_SALT_KEY=<openssl rand -hex 24>
# Gateway <-> instance <-> nexus. Rotating needs a short window where both values are accepted.
SANDBOX_TOKEN=<openssl rand -hex 24>
BROWSER_TOKEN=<openssl rand -hex 24>

# ---- seed credentials --------------------------------------------------------
# The first installation's accounts: platform administrator `plat`, platform user `user01` (owner of the
# tenant), the tenant administrator, and the API key of the tenant's primary user.
#
# These are the demo box's values on purpose: the seed content is identical to the PoC, which is what makes
# "verified in the demo" transfer. Change the password after the first login and rotate the key - the README's
# security section says it again, and install.sh writes them to /etc/flame/initial-credentials.txt.
FLAME_ADMIN_PASSWORD=12345678
FLAME_API_KEY=sk-poc-t0-primary
FLAME_TENANT_SCHEMA=t0
FLAME_TENANT_TITLE="Default tenant"

# ---- data plane, as seen from the containers ---------------------------------
# Tier 3: the first machine's intranet address (PostgreSQL / Redis / LiteLLM published there).
FLAME_DB_HOST=postgres
FLAME_REDIS_ADDR=redis:6379
FLAME_LITELLM_HOST=litellm
# Full gateway URLs; nexus dials these. Empty disables that tool family and, for the sandbox, also drops the
# readiness gate - useful for a trial, wrong for a deployment.
FLAME_SANDBOX_URL=ws://sandboxg:27080
FLAME_BROWSER_URL=ws://browserg:27090

# ---- consul, two views of the same registry ----------------------------------
# _HOST: what the bare-metal executors dial. Tier 1 = the loopback publish of the consul container;
#        tier 2/3 = this machine's intranet address.
# _NET:  what the gateway containers dial. Tier 1/2 = the compose service name; tier 3 (gateways elsewhere) =
#        the first machine's intranet address.
FLAME_CONSUL_ADDR_HOST=127.0.0.1:8500
FLAME_CONSUL_ADDR_NET=consul:8500
